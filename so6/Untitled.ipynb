    "from sympy import *\n",
    "x=symbols('x')\n",
    "eq=Eq(3*x,556867)\n",
    "results=solve(eq,x)\n",
    "g=[]\n",
    "for b in results:\n",
    "    g.append(round(b, 2))\n",
    "\n",
    "print(g)"
